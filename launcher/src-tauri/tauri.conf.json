{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Privateer Reimagined",
  "version": "0.3.3",
  "identifier": "com.privateer-reimagined.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Privateer Reimagined",
        "width": 1060,
        "height": 660,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src https://privateer-reimagined.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBNEU0MjIxNTU4MkNEMDEKUldRQnpZSlZJVUpPMnNobkFxZFRpQTBSRUxYNlJBSDdiY1pIY2tDa28xcUVEV2JoNzgrVlpqY24K",
      "endpoints": ["https://cdn.privateer-reimagined.com/launcher/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "copyright": "Copyright © 2026 Michael Pfaffenberger",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
